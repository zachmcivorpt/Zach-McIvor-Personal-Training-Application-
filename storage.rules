rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /messageVideos/{clientId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        (request.auth.uid == clientId ||
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "coach") &&
        request.resource.size < 200 * 1024 * 1024 &&
        request.resource.contentType.matches('video/.*');
    }
    match /messageDocs/{clientId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        (request.auth.uid == clientId ||
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "coach") &&
        request.resource.size < 20 * 1024 * 1024 &&
        request.resource.contentType == 'application/pdf';
    }
    match /messageAudio/{clientId}/{fileName} {
      // Voice notes in chat — same who-can-write as the other message
      // attachments, audio only, 20MB cap (a 2-minute note is ~1–2MB).
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        (request.auth.uid == clientId ||
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "coach") &&
        request.resource.size < 20 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');
    }
    match /messageImages/{clientId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        (request.auth.uid == clientId ||
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "coach") &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
    match /design/{fileName} {
      // The login background (photo OR a short video) and the app logo —
      // anyone can READ (the login screen loads the background before
      // anyone signs in), only the coach can write. A background video
      // gets a bigger cap than a still image/the logo, since it's still
      // one file autoplaying on every visit rather than a message
      // attachment someone deliberately opens.
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "coach" &&
        (
          (request.resource.contentType.matches('image/.*') && request.resource.size < 8 * 1024 * 1024) ||
          (request.resource.contentType.matches('video/.*') && request.resource.size < 25 * 1024 * 1024)
        );
    }
    match /soloProgramArt/{fileName} {
      // Train Solo program cover artwork — public read (the catalogue
      // loads it pre-login), coach-only write. Same shape and size cap as
      // the design/ image rule above.
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "coach" &&
        request.resource.contentType.matches('image/.*') && request.resource.size < 8 * 1024 * 1024;
    }
  }
}
