rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isCoach() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "coach";
    }

    function ownsClientId(clientId) {
      return isSignedIn() && request.auth.uid == clientId;
    }

    // --- users/{uid} -------------------------------------------------
    match /users/{userId} {
      allow read: if isCoach() || (isSignedIn() && request.auth.uid == userId);

      // Every account (coach or client) creates its OWN doc, right after
      // Firebase Auth confirms the credential. The coach can ALSO create
      // a doc for any userId directly — this is what lets a coach save
      // Personal Details/tags/nutrition targets for a client who hasn't
      // activated yet: that first save is a Firestore "create" (there's
      // no existing users/{email} doc for a still-pending invite), and
      // without this the coach's own write was rejected outright with
      // "Missing or insufficient permissions."
      allow create: if isCoach() ||
        (isSignedIn() && request.auth.uid == userId &&
          (
            // Creating the coach account: only ever allowed once, ever.
            (request.resource.data.role == "coach" &&
              (!exists(/databases/$(database)/documents/settings/appMeta) ||
               get(/databases/$(database)/documents/settings/appMeta).data.hasCoach != true))
            ||
            // Creating a client account: only if a matching invite exists.
            (request.resource.data.role == "client" &&
              exists(/databases/$(database)/documents/invites/$(request.resource.data.email)))
          )
        );

      // Coach can edit anyone. A client can edit their own profile fields
      // but never change their own role.
      allow update: if isCoach() ||
        (isSignedIn() && request.auth.uid == userId &&
         request.resource.data.role == resource.data.role);

      allow delete: if isCoach();
    }

    // --- invites/{email} ----------------------------------------------
    match /invites/{email} {
      // Looking up ONE invite by its known email (pre-auth activation) is
      // fine — but browsing the full list is coach-only.
      allow get: if true;
      allow list: if isCoach();
      allow create, update: if isCoach();
      // Coach can cancel any invite; a freshly-activated client can clean
      // up their own now-used invite (their new profile's email must
      // match this invite's id).
      allow delete: if isCoach() ||
        (isSignedIn() &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == email);
    }

    // --- settings/appMeta, settings/welcomeMessage ---------------------
    match /settings/appMeta {
      // Public so the login screen can tell "no coach yet" from "signed
      // in as who?" before anyone is authenticated.
      allow read: if true;
      allow write: if isCoach();
    }

    match /settings/welcomeMessage {
      // Readable pre-auth too, so a brand new client's auto-welcome
      // message can be sent the moment their account is created.
      allow read: if true;
      allow write: if isCoach();
    }

    match /settings/coachProfile {
      // Public mirror of the coach's name/avatar — lets a client's app
      // (e.g. the chat bubble) show who their coach is without needing
      // broad read access to the users collection. Kept in sync
      // automatically whenever the coach's own profile changes.
      allow read: if true;
      allow write: if isCoach();
    }

    match /settings/appDesign {
      // Coach-customizable branding (login background photo, app logo).
      // Public so the login screen can load the background before anyone
      // signs in.
      allow read: if true;
      allow write: if isCoach();
    }

    // --- settings/soloBranding: Train Solo's own, separate branding
    //     setting — currently just an accent colour. Deliberately its own
    //     doc, not a field added to settings/appDesign above: that doc is
    //     Coaching's, and Train Solo's logo is NOT configurable (it's
    //     always the real APEX mark, never a per-coach choice), so the
    //     only thing that actually needs storing here is the accent.
    //     Same public-read/coach-write shape as settings/appDesign. ---
    match /settings/soloBranding {
      allow read: if true;
      allow write: if isCoach();
    }


    // --- shared library data: any signed-in user reads, coach writes ---
    match /exercises/{id} {
      allow read: if isSignedIn();
      allow write: if isCoach();
    }
    match /programs/{id} {
      allow read: if isSignedIn();
      allow write: if isCoach();
    }
    match /masterWorkouts/{id} {
      allow read: if isSignedIn();
      allow write: if isCoach();
    }
    match /masterMeals/{id} {
      allow read: if isSignedIn();
      allow write: if isCoach();
    }
    match /customFoods/{id} {
      allow read: if isSignedIn();
      // Any signed-in client can add a food discovered via barcode lookup
      // (manual entry when a scan/lookup comes up empty) so it's saved for
      // next time — only the coach can edit or remove library entries.
      allow create: if isSignedIn();
      allow update, delete: if isCoach();
    }
    match /habitPresets/{id} {
      allow read: if isSignedIn();
      allow write: if isCoach();
    }
    match /forms/{id} {
      allow read: if isSignedIn();
      allow write: if isCoach();
    }

    // --- per-client data: coach reads/writes all, client reads/writes
    //     only their own (matched by the clientId field on each doc) ---
    match /workoutLogs/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach() || (isSignedIn() && resource.data.clientId == request.auth.uid);
    }
    match /weighIns/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach() || (isSignedIn() && resource.data.clientId == request.auth.uid);
    }
    // setNutritionForDate (AppContext.jsx) reads this doc inside a
    // transaction to check whether it already exists before deciding
    // whether to create or merge — for a client's first-ever nutrition log
    // on a given day, that document doesn't exist yet, so `resource` is
    // null. Without the `resource == null` clause, `resource.data.clientId`
    // on a null resource throws, and Firestore treats any error while
    // evaluating a rule as a denial — so every brand-new client's very
    // first save failed with "Missing or insufficient permissions" before
    // it ever reached the create step. A nonexistent document has nothing
    // to protect, so it's safe to let the existence check through.
    match /nutritionLogs/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach() || (isSignedIn() && resource.data.clientId == request.auth.uid);
    }
    match /bodyMetrics/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach() || (isSignedIn() && resource.data.clientId == request.auth.uid);
    }
    match /mealPlans/{id} {
      // Doc id == clientId. Only the coach creates/deletes a plan; a
      // client may update() their own doc (used by the "swap this meal"
      // feature) but can never reassign it to a different clientId.
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create, delete: if isCoach();
      allow update: if isCoach() ||
        (isSignedIn() && resource.data.clientId == request.auth.uid && request.resource.data.clientId == resource.data.clientId);
    }
    match /scheduledWorkouts/{id} {
      // A client can drag-reschedule their own calendar (create the moved
      // copy + delete the original), same as the coach already could.
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach() || (isSignedIn() && resource.data.clientId == request.auth.uid);
    }
    match /bodyStatsSchedules/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach() || (isSignedIn() && resource.data.clientId == request.auth.uid);
    }
    match /messages/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      // `from` ("coach"/"client") used to go unchecked here — the rule only
      // verified WHOSE thread a message landed in (via clientId), never
      // who the signed-in writer actually was relative to that `from`
      // value. A signed-in client could write into their own thread
      // (clientId == their own uid, already required) but set
      // `from: "coach"`, and it would render identically to a real
      // coach-sent message. Now the authenticated role and the self-
      // declared sender must actually match: a coach-authenticated write
      // must claim from=="coach"; a client-authenticated write (already
      // scoped to their own clientId) must claim from=="client".
      allow create: if (isCoach() && request.resource.data.from == "coach") ||
        (ownsClientId(request.resource.data.clientId) && request.resource.data.from == "client");
      allow update, delete: if isCoach();
    }
    // --- workoutComments/{id}: the per-workout comment thread shown from
    //     a completed workout's "..." menu — both the coach and that
    //     workout's own client can read/post; only the coach can edit or
    //     delete an entry (mirrors messages). ---
    match /workoutComments/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach();
    }
    match /progressPhotos/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach() || (isSignedIn() && resource.data.clientId == request.auth.uid);
    }
    match /savedMeals/{id} {
      // "My Meals" is each client's own personal saved-meal list — not a
      // shared library, so read is scoped to the creating client (or the
      // coach, who can see every client's), same as progressPhotos.
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach() || (isSignedIn() && resource.data.clientId == request.auth.uid);
    }
    match /habits/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach() || (isSignedIn() && resource.data.clientId == request.auth.uid);
    }
    match /clientPhases/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow write: if isCoach();
    }
    match /formSchedules/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow write: if isCoach();
    }
    match /formResponses/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach();
    }

    // --- clientNotes: private trainer notes. The client app never reads
    //     this collection — keep it that way at the rules level too. ---
    match /clientNotes/{id} {
      allow read, write: if isCoach();
    }

    // --- clientContext: structured client context, either entered by the
    //     coach directly or approved by the coach from an APEX-detected
    //     suggestion on a note. Same private-to-coach exposure as
    //     clientNotes above — the client app never reads it. ---
    match /clientContext/{id} {
      allow read, write: if isCoach();
    }

    // --- habitLog/{clientId}: doc id IS the client's uid --------------
    match /habitLog/{clientId} {
      allow read, write: if isCoach() || ownsClientId(clientId);
    }

    // --- notifications/{id}: coach-facing alerts (e.g. a client updated
    //     their preferences). A client can create one about themselves,
    //     but never read the list back or edit/delete one. ---
    match /notifications/{id} {
      allow read: if isCoach();
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach();
    }

    // --- errorLogs/{id}: a client's own save failure, written client-side
    //     so a coach can see it without the client having to report it.
    //     Same access shape as notifications/{id} above. ---
    match /errorLogs/{id} {
      allow read: if isCoach();
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach();
    }

    // --- challenges/{id}: coach creates/manages; a client can read one
    //     only while they're listed as a participant. ---
    match /challenges/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || request.auth.uid in resource.data.participantIds));
      allow write: if isCoach();
    }

    // --- groups/{id}: coach creates/manages (name, description,
    //     membership) — same shape as challenges/{id} above. A member can
    //     read their own group but never edit its membership/settings
    //     directly; that stays a coach-only action via the Groups tab. ---
    match /groups/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || request.auth.uid in resource.data.memberIds));
      allow write: if isCoach();
    }
    // --- groupMessages/{id}: the chat for a single group. memberIds is
    //     stamped onto every message at send time (see sendGroupMessage in
    //     AppContext.jsx) from the group's roster at that moment — a
    //     member can read/post into a group they're currently in; the
    //     `from`/`fromClientId` check on create stops a client from
    //     posting a message under anyone else's identity. Editing or
    //     deleting a message stays coach-only, same as the 1:1 messages
    //     collection above. ---
    match /groupMessages/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || request.auth.uid in resource.data.memberIds));
      allow create: if isCoach() ||
        (isSignedIn() && request.auth.uid in request.resource.data.memberIds &&
         request.resource.data.from == "client" && request.resource.data.fromClientId == request.auth.uid);
      allow update, delete: if isCoach();
    }

    // --- whoopTokens/{clientId}: a connected client's WHOOP OAuth
    //     access/refresh tokens. Deliberately NO allow rules — only
    //     Cloud Functions (Admin SDK, bypasses these rules) ever touch
    //     this collection. Not even the coach can read it from the app;
    //     there's nothing in here a coach dashboard needs; the synced
    //     recovery/sleep/strain numbers themselves land in the already-
    //     readable bodyMetrics collection instead. ---
    match /whoopTokens/{clientId} {
      allow read, write: if false;
    }

    // --- liveSessions/{clientId}: doc id IS the client's uid. A real-time
    //     mirror of a workout session WHILE it's in progress — only the
    //     owning client ever writes it (from their own device, the moment
    //     they're mid-session); the coach only ever reads it, to watch a
    //     remote session live from CoachClientDetail. ---
    match /liveSessions/{clientId} {
      allow read: if isCoach() || ownsClientId(clientId);
      allow write: if ownsClientId(clientId);
    }

    // --- soloUsers/{uid}: Train Solo's independent accounts — the new,
    //     separate side of the app alongside Coaching (see
    //     src/lib/SoloAppContext.jsx). Deliberately its own collection, not
    //     a third role inside users/{uid}: a Train Solo account has no
    //     coach and must never be reachable by isCoach()'s blanket grant,
    //     or appear in any coach-facing client list/query. Every existing
    //     match block above (users, workoutLogs, programs, etc.) is
    //     unchanged by this addition. Firestore Security Rules evaluate
    //     request.auth by the verified uid on whichever ID token a given
    //     request actually carries — a request made through soloAuth/
    //     soloDb (a separate named Firebase app, same project) carries a
    //     Train Solo user's own token, completely independent of whatever
    //     Coaching session (if any) exists in the same browser. ---
    match /soloUsers/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // --- soloProgramCategories/{id}, soloPrograms/{id}: Train Solo's own
    //     program catalogue — entirely separate from Coaching's programs/
    //     collection above, never read from it and never written to it.
    //     Public read, same pattern as settings/appDesign: a Train Solo
    //     customer browsing the catalogue (Phase 2) needs this before/
    //     without a Coaching session, and a published program's existence
    //     isn't sensitive — draft vs. published filtering happens in the
    //     client query, same as every other public-read settings doc. Only
    //     the coach can create/edit/reorder/archive a category or a
    //     program; this isCoach() check is the same one every other
    //     coach-only collection in this file already uses. ---
    match /soloProgramCategories/{id} {
      allow read: if true;
      allow write: if isCoach();
    }
    // Public catalogue data only — name, price, level, description,
    // artwork, categories, and the small weekOnePreview slice (total week
    // count + the existing two-exercise Day 1 preview). The full
    // phases/days/exercises array is NEVER written here — see
    // soloProgramContent below, and AppContext.jsx's createSoloProgram/
    // updateSoloProgram, which enforce the split on every write. This is
    // the actual fix for the confirmed finding that a public, whole-
    // document-read rule on a doc that also held full content let anyone
    // read a program's content for free, regardless of purchase.
    match /soloPrograms/{id} {
      allow read: if true;
      allow write: if isCoach();
    }

    // --- soloProgramContent/{id}: the full phases/days/exercises for one
    //     Solo program, same doc id as its soloPrograms entry. Coach-read
    //     (building/editing), or a customer with a matching soloPurchases
    //     doc — see the deterministic id scheme below, which is exactly
    //     what this exists() check relies on: rules can't run an
    //     arbitrary query, only check a known path, so the purchase doc's
    //     id must already encode which customer owns which program.
    //     Deliberately checked by purchase existence alone, not by the
    //     program's current publish status — a customer keeps access to
    //     content they already own even if the coach later moves that
    //     program back to draft; it's "can never access an unpurchased
    //     program's content," not "can never access a since-unpublished
    //     one." ---
    match /soloProgramContent/{id} {
      // exists() first so a customer who's never purchased this program
      // short-circuits to false instead of get() throwing on a missing
      // doc; refunded != true (via .get() with a default, since an
      // old/placeholder purchase predating refunds has no `refunded`
      // field at all) is what actually revokes access once
      // soloStripeWebhook marks a purchase refunded — a refund doesn't
      // delete the purchase doc (real purchase history stays visible in
      // My Training/Profile), so exists() alone would otherwise keep
      // granting content access forever after a refund.
      allow read: if isCoach() ||
        (isSignedIn() &&
          exists(/databases/$(database)/documents/soloPurchases/$(request.auth.uid + '_' + id)) &&
          get(/databases/$(database)/documents/soloPurchases/$(request.auth.uid + '_' + id)).data.get("refunded", false) != true) ||
        (hasAllAccess() &&
          get(/databases/$(database)/documents/soloPrograms/$(id)).data.get("status", "") == "published");
      allow write: if isCoach();
    }

    // An All Access subscription that's paid up right now. allAccessUntil
    // is written only by the server (functions/soloSubscriptions.js) from
    // Stripe and Apple: the end of the paid period while a subscription is
    // active or in its free trial, and 0 the moment a payment fails, it's
    // cancelled and has run out, or it's refunded. A customer can never
    // write it (soloEntitlements below).
    function hasAllAccess() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/soloEntitlements/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/soloEntitlements/$(request.auth.uid)).data.get("allAccessUntil", 0) > request.time.toMillis();
    }

    // --- soloEntitlements/{uid}: which Train Solo tier a customer has paid
    //     for (Free / Plus / All Access), per store. Server-written only:
    //     Stripe's and RevenueCat's webhooks (Admin SDK, bypassing these
    //     rules) after verifying the request really came from them. The
    //     customer can read their own; nobody can write it from an app. ---
    match /soloEntitlements/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // --- soloEnrolments/{uid}_{programId}: a program a customer is running
    //     through All Access, and its schedule (start date, paused or
    //     active — src/solo/enrolments.js). The customer's own to write:
    //     an enrolment schedules a program, it never grants access to one
    //     (the content stays behind hasAllAccess() above). The id is pinned
    //     to `{uid}_{programId}`, the same id a purchase of it would have,
    //     so workout logs line up either way. The app never deletes one (it
    //     keeps the program's place for when the customer comes back to
    //     it); only the customer can, as part of deleting their account. ---
    match /soloEnrolments/{id} {
      allow read: if isSignedIn() && resource.data.soloUserId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.soloUserId == request.auth.uid &&
        id == request.auth.uid + '_' + request.resource.data.programId;
      allow update: if isSignedIn() && resource.data.soloUserId == request.auth.uid &&
        request.resource.data.soloUserId == resource.data.soloUserId &&
        request.resource.data.programId == resource.data.programId;
      allow delete: if isSignedIn() && resource.data.soloUserId == request.auth.uid;
    }

    // --- settings/soloMonetisation: the subscriptions launch switch
    //     ({ live, testUids }) — public read so the app knows whether tier
    //     gates apply; only the coach turns it on (coach console). ---
    match /settings/soloMonetisation {
      allow read: if true;
      allow write: if isCoach();
    }

    // --- soloPurchases/{id}: a Train Solo customer's ownership of one
    //     program — what actually gates locked content (soloProgramContent
    //     above). Scoped entirely to the owning soloUserId, same shape as
    //     every other "a user reads/writes only their own doc" collection
    //     in this file (soloUsers above). isSignedIn() has no role check,
    //     so this works unchanged for a Train Solo account signed in via
    //     soloAuth; nothing here is reachable by isCoach()'s blanket grant
    //     or by any Coaching collection.
    //
    //     Create is `if false`: now that Solo programs are real, paid
    //     purchases (Stripe), the ONLY thing allowed to create a doc here
    //     is functions/index.js's soloStripeWebhook, running with the
    //     Admin SDK (which bypasses these rules entirely) only after
    //     Stripe's signature on the webhook payload has been verified —
    //     never the client. The Phase 2 placeholder path
    //     (purchaseProgramPlaceholder, a direct client create) is retired;
    //     a client granting itself access to paid content would otherwise
    //     be exactly as easy as this `allow create` rule let it be.
    //
    //     The doc id is still `{uid}_{programId}` (the webhook enforces
    //     this by construction, not a rule check it's subject to) — a
    //     customer can hold at most one purchase per program ever,
    //     keeping soloProgramContent's exists() check above meaningful. ---
    match /soloPurchases/{id} {
      allow read: if isSignedIn() && resource.data.soloUserId == request.auth.uid;
      allow create: if false;
      // Only the start date is ever edited by the client post-purchase
      // (picking/changing a start date) — `.diff().affectedKeys()` scopes
      // that down to literally that one field, so a signed-in owner can
      // never flip their own placeholder/refunded/payment-reference
      // fields back to "owned" after a refund, the way checking those
      // fields individually (matching their prior value) would still have
      // allowed if a future field were ever added here and missed.
      allow update: if isSignedIn() && resource.data.soloUserId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["startDate"]);
      allow delete: if false;
    }

    // --- soloWorkoutLogs/{id}: a Train Solo customer's own completed-
    //     workout history — the Phase 3 training experience. Same
    //     ownership shape as soloPurchases above: a customer can only
    //     ever read/write their OWN logs, never another customer's, and
    //     can never reassign a log to a different soloUserId after the
    //     fact. Entirely separate from Coaching's workoutLogs collection
    //     — never read from it, never written to it. ---
    match /soloWorkoutLogs/{id} {
      allow read: if isSignedIn() && resource.data.soloUserId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.soloUserId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.soloUserId == request.auth.uid &&
        request.resource.data.soloUserId == resource.data.soloUserId;
      allow delete: if isSignedIn() && resource.data.soloUserId == request.auth.uid;
    }

    // --- soloWeighIns/{id}: a Train Solo customer's own body-weight log —
    //     the Progress tab. Same ownership shape as soloWorkoutLogs above:
    //     a customer can only ever read/write their OWN entries, never
    //     another customer's, and can never reassign one to a different
    //     soloUserId. Entirely separate from Coaching's weighIns
    //     collection — never read from it, never written to it, and never
    //     visible to a coach (self-guided progress has no coach check-in
    //     workflow by design). ---
    match /soloWeighIns/{id} {
      allow read: if isSignedIn() && resource.data.soloUserId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.soloUserId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.soloUserId == request.auth.uid &&
        request.resource.data.soloUserId == resource.data.soloUserId;
      allow delete: if isSignedIn() && resource.data.soloUserId == request.auth.uid;
    }

    // --- soloProgressPhotos/{id}: a Train Solo customer's own progress-
    //     photo timeline — same ownership shape as soloWeighIns above, and
    //     equally separate from Coaching's progressPhotos collection. No
    //     update rule: a photo is immutable once created (matches
    //     Coaching's own addProgressPhoto/deleteProgressPhoto — create or
    //     delete, never edit). ---
    match /soloProgressPhotos/{id} {
      allow read: if isSignedIn() && resource.data.soloUserId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.soloUserId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.soloUserId == request.auth.uid;
    }

    // --- soloBodyMetrics/{id}: a Train Solo customer's own steps/sleep/
    //     resting-heart-rate/body-fat/lean-mass/measurements log, one doc
    //     per customer per calendar day (id is `{uid}_{dateKey}`, mirroring
    //     Coaching's own bodyMetrics). Same ownership shape as
    //     soloWeighIns — entirely separate from Coaching's bodyMetrics
    //     collection. ---
    match /soloBodyMetrics/{id} {
      allow read: if isSignedIn() && resource.data.soloUserId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.soloUserId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.soloUserId == request.auth.uid &&
        request.resource.data.soloUserId == resource.data.soloUserId;
      allow delete: if isSignedIn() && resource.data.soloUserId == request.auth.uid;
    }

    // --- soloCustomSessions/{id}: sessions a Train Solo customer built
    //     themselves (free training — src/solo/customSessions.js). Same
    //     ownership shape as soloWorkoutLogs: only that customer reads or
    //     writes them, and one can never be handed to another account. ---
    match /soloCustomSessions/{id} {
      allow read: if isSignedIn() && resource.data.soloUserId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.soloUserId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.soloUserId == request.auth.uid &&
        request.resource.data.soloUserId == resource.data.soloUserId;
      allow delete: if isSignedIn() && resource.data.soloUserId == request.auth.uid;
    }

    // --- soloCustomPrograms/{id}: multi-week programs a Plus customer
    //     built from their own sessions (src/solo/customPrograms.js). Same
    //     ownership shape as soloCustomSessions. ---
    match /soloCustomPrograms/{id} {
      allow read: if isSignedIn() && resource.data.soloUserId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.soloUserId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.soloUserId == request.auth.uid &&
        request.resource.data.soloUserId == resource.data.soloUserId;
      allow delete: if isSignedIn() && resource.data.soloUserId == request.auth.uid;
    }

    // --- soloWaterLogs/{id}: a Train Solo customer's own daily water
    //     intake (My Training's water tracker), one doc per customer per
    //     day (id `{uid}_{dateKey}`). Same ownership shape as
    //     soloBodyMetrics; a separate collection so water never counts as
    //     the Monday body-stats check-in. ---
    match /soloWaterLogs/{id} {
      allow read: if isSignedIn() && (resource == null || resource.data.soloUserId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.soloUserId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.soloUserId == request.auth.uid &&
        request.resource.data.soloUserId == resource.data.soloUserId;
      allow delete: if isSignedIn() && resource.data.soloUserId == request.auth.uid;
    }
  }
}
