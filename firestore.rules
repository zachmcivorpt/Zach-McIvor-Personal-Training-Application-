rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isCoach() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "coach";
    }

    function ownsClientId(clientId) {
      return isSignedIn() && request.auth.uid == clientId;
    }

    // --- users/{uid} -------------------------------------------------
    match /users/{userId} {
      allow read: if isCoach() || (isSignedIn() && request.auth.uid == userId);

      // Every account (coach or client) creates its OWN doc, right after
      // Firebase Auth confirms the credential. The coach can ALSO create
      // a doc for any userId directly — this is what lets a coach save
      // Personal Details/tags/nutrition targets for a client who hasn't
      // activated yet: that first save is a Firestore "create" (there's
      // no existing users/{email} doc for a still-pending invite), and
      // without this the coach's own write was rejected outright with
      // "Missing or insufficient permissions."
      allow create: if isCoach() ||
        (isSignedIn() && request.auth.uid == userId &&
          (
            // Creating the coach account: only ever allowed once, ever.
            (request.resource.data.role == "coach" &&
              (!exists(/databases/$(database)/documents/settings/appMeta) ||
               get(/databases/$(database)/documents/settings/appMeta).data.hasCoach != true))
            ||
            // Creating a client account: only if a matching invite exists.
            (request.resource.data.role == "client" &&
              exists(/databases/$(database)/documents/invites/$(request.resource.data.email)))
          )
        );

      // Coach can edit anyone. A client can edit their own profile fields
      // but never change their own role.
      allow update: if isCoach() ||
        (isSignedIn() && request.auth.uid == userId &&
         request.resource.data.role == resource.data.role);

      allow delete: if isCoach();
    }

    // --- invites/{email} ----------------------------------------------
    match /invites/{email} {
      // Looking up ONE invite by its known email (pre-auth activation) is
      // fine — but browsing the full list is coach-only.
      allow get: if true;
      allow list: if isCoach();
      allow create, update: if isCoach();
      // Coach can cancel any invite; a freshly-activated client can clean
      // up their own now-used invite (their new profile's email must
      // match this invite's id).
      allow delete: if isCoach() ||
        (isSignedIn() &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == email);
    }

    // --- settings/appMeta, settings/welcomeMessage ---------------------
    match /settings/appMeta {
      // Public so the login screen can tell "no coach yet" from "signed
      // in as who?" before anyone is authenticated.
      allow read: if true;
      allow write: if isCoach();
    }

    match /settings/welcomeMessage {
      // Readable pre-auth too, so a brand new client's auto-welcome
      // message can be sent the moment their account is created.
      allow read: if true;
      allow write: if isCoach();
    }

    match /settings/coachProfile {
      // Public mirror of the coach's name/avatar — lets a client's app
      // (e.g. the chat bubble) show who their coach is without needing
      // broad read access to the users collection. Kept in sync
      // automatically whenever the coach's own profile changes.
      allow read: if true;
      allow write: if isCoach();
    }

    match /settings/appDesign {
      // Coach-customizable branding (login background photo, app logo).
      // Public so the login screen can load the background before anyone
      // signs in.
      allow read: if true;
      allow write: if isCoach();
    }

    // --- shared library data: any signed-in user reads, coach writes ---
    match /exercises/{id} {
      allow read: if isSignedIn();
      allow write: if isCoach();
    }
    match /programs/{id} {
      allow read: if isSignedIn();
      allow write: if isCoach();
    }
    match /masterWorkouts/{id} {
      allow read: if isSignedIn();
      allow write: if isCoach();
    }
    match /masterMeals/{id} {
      allow read: if isSignedIn();
      allow write: if isCoach();
    }
    match /customFoods/{id} {
      allow read: if isSignedIn();
      // Any signed-in client can add a food discovered via barcode lookup
      // (manual entry when a scan/lookup comes up empty) so it's saved for
      // next time — only the coach can edit or remove library entries.
      allow create: if isSignedIn();
      allow update, delete: if isCoach();
    }
    match /habitPresets/{id} {
      allow read: if isSignedIn();
      allow write: if isCoach();
    }
    match /forms/{id} {
      allow read: if isSignedIn();
      allow write: if isCoach();
    }

    // --- per-client data: coach reads/writes all, client reads/writes
    //     only their own (matched by the clientId field on each doc) ---
    match /workoutLogs/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach() || (isSignedIn() && resource.data.clientId == request.auth.uid);
    }
    match /weighIns/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach() || (isSignedIn() && resource.data.clientId == request.auth.uid);
    }
    // setNutritionForDate (AppContext.jsx) reads this doc inside a
    // transaction to check whether it already exists before deciding
    // whether to create or merge — for a client's first-ever nutrition log
    // on a given day, that document doesn't exist yet, so `resource` is
    // null. Without the `resource == null` clause, `resource.data.clientId`
    // on a null resource throws, and Firestore treats any error while
    // evaluating a rule as a denial — so every brand-new client's very
    // first save failed with "Missing or insufficient permissions" before
    // it ever reached the create step. A nonexistent document has nothing
    // to protect, so it's safe to let the existence check through.
    match /nutritionLogs/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach() || (isSignedIn() && resource.data.clientId == request.auth.uid);
    }
    match /bodyMetrics/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach() || (isSignedIn() && resource.data.clientId == request.auth.uid);
    }
    match /mealPlans/{id} {
      // Doc id == clientId. Only the coach creates/deletes a plan; a
      // client may update() their own doc (used by the "swap this meal"
      // feature) but can never reassign it to a different clientId.
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create, delete: if isCoach();
      allow update: if isCoach() ||
        (isSignedIn() && resource.data.clientId == request.auth.uid && request.resource.data.clientId == resource.data.clientId);
    }
    match /scheduledWorkouts/{id} {
      // A client can drag-reschedule their own calendar (create the moved
      // copy + delete the original), same as the coach already could.
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach() || (isSignedIn() && resource.data.clientId == request.auth.uid);
    }
    match /bodyStatsSchedules/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach() || (isSignedIn() && resource.data.clientId == request.auth.uid);
    }
    match /messages/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach();
    }
    // --- workoutComments/{id}: the per-workout comment thread shown from
    //     a completed workout's "..." menu — both the coach and that
    //     workout's own client can read/post; only the coach can edit or
    //     delete an entry (mirrors messages). ---
    match /workoutComments/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach();
    }
    match /progressPhotos/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach() || (isSignedIn() && resource.data.clientId == request.auth.uid);
    }
    match /savedMeals/{id} {
      // "My Meals" is each client's own personal saved-meal list — not a
      // shared library, so read is scoped to the creating client (or the
      // coach, who can see every client's), same as progressPhotos.
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach() || (isSignedIn() && resource.data.clientId == request.auth.uid);
    }
    match /habits/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach() || (isSignedIn() && resource.data.clientId == request.auth.uid);
    }
    match /clientPhases/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow write: if isCoach();
    }
    match /formSchedules/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow write: if isCoach();
    }
    match /formResponses/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || resource.data.clientId == request.auth.uid));
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach();
    }

    // --- clientNotes: private trainer notes. The client app never reads
    //     this collection — keep it that way at the rules level too. ---
    match /clientNotes/{id} {
      allow read, write: if isCoach();
    }

    // --- clientContext: structured client context, either entered by the
    //     coach directly or approved by the coach from an APEX-detected
    //     suggestion on a note. Same private-to-coach exposure as
    //     clientNotes above — the client app never reads it. ---
    match /clientContext/{id} {
      allow read, write: if isCoach();
    }

    // --- habitLog/{clientId}: doc id IS the client's uid --------------
    match /habitLog/{clientId} {
      allow read, write: if isCoach() || ownsClientId(clientId);
    }

    // --- notifications/{id}: coach-facing alerts (e.g. a client updated
    //     their preferences). A client can create one about themselves,
    //     but never read the list back or edit/delete one. ---
    match /notifications/{id} {
      allow read: if isCoach();
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach();
    }

    // --- errorLogs/{id}: a client's own save failure, written client-side
    //     so a coach can see it without the client having to report it.
    //     Same access shape as notifications/{id} above. ---
    match /errorLogs/{id} {
      allow read: if isCoach();
      allow create: if isCoach() || ownsClientId(request.resource.data.clientId);
      allow update, delete: if isCoach();
    }

    // --- challenges/{id}: coach creates/manages; a client can read one
    //     only while they're listed as a participant. ---
    match /challenges/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || request.auth.uid in resource.data.participantIds));
      allow write: if isCoach();
    }

    // --- groups/{id}: coach creates/manages (name, description,
    //     membership) — same shape as challenges/{id} above. A member can
    //     read their own group but never edit its membership/settings
    //     directly; that stays a coach-only action via the Groups tab. ---
    match /groups/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || request.auth.uid in resource.data.memberIds));
      allow write: if isCoach();
    }
    // --- groupMessages/{id}: the chat for a single group. memberIds is
    //     stamped onto every message at send time (see sendGroupMessage in
    //     AppContext.jsx) from the group's roster at that moment — a
    //     member can read/post into a group they're currently in; the
    //     `from`/`fromClientId` check on create stops a client from
    //     posting a message under anyone else's identity. Editing or
    //     deleting a message stays coach-only, same as the 1:1 messages
    //     collection above. ---
    match /groupMessages/{id} {
      allow read: if isCoach() || (isSignedIn() && (resource == null || request.auth.uid in resource.data.memberIds));
      allow create: if isCoach() ||
        (isSignedIn() && request.auth.uid in request.resource.data.memberIds &&
         request.resource.data.from == "client" && request.resource.data.fromClientId == request.auth.uid);
      allow update, delete: if isCoach();
    }

    // --- whoopTokens/{clientId}: a connected client's WHOOP OAuth
    //     access/refresh tokens. Deliberately NO allow rules — only
    //     Cloud Functions (Admin SDK, bypasses these rules) ever touch
    //     this collection. Not even the coach can read it from the app;
    //     there's nothing in here a coach dashboard needs; the synced
    //     recovery/sleep/strain numbers themselves land in the already-
    //     readable bodyMetrics collection instead. ---
    match /whoopTokens/{clientId} {
      allow read, write: if false;
    }

    // --- liveSessions/{clientId}: doc id IS the client's uid. A real-time
    //     mirror of a workout session WHILE it's in progress — only the
    //     owning client ever writes it (from their own device, the moment
    //     they're mid-session); the coach only ever reads it, to watch a
    //     remote session live from CoachClientDetail. ---
    match /liveSessions/{clientId} {
      allow read: if isCoach() || ownsClientId(clientId);
      allow write: if ownsClientId(clientId);
    }
  }
}
